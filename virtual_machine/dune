; the virtual machine is built on Linux only: it relies on Linux-specific mmap flags and
; linker options

(rule
 (target lama.exe)
 (enabled_if
  (= %{system} linux))
 (mode
  (promote (until-clean)))
 (deps
  Makefile
  lama.c
  converter.c
  vm.c
  bytecode.c
  ffi.c
  loader.c
  symbols.c
  ops.c
  memory.c
  opcodes.c
  disasm.c
  (glob_files *.h)
  ../runtime/Makefile
  ../runtime/gc.c
  ../runtime/gc.h
  ../runtime/runtime.c
  ../runtime/runtime.h
  ../runtime/runtime_common.h
  ../runtime/printf.S)
 (action
  (run
   make
   TARGET=%{target})))

(alias
 (name default)
 (enabled_if
  (= %{system} linux))
 (deps lama.exe))

(install
 (section bin)
 (enabled_if
  (= %{system} linux))
 (files
  (lama.exe as lamavm)))
