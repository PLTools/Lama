-- (C) Dmitry Boulytchev, St. Petersburg State University, JetBrains Research, 2020
-- Matcher: simple string matching library.

-- Create a regular expression representation.
-- Arguments:
--    r    --- a string representation for regular expression (as per GNU regexp)
--    name --- a string describing the meaning of the expression in free form
--             (e.g. "identifier", "string constant", etc.), used for error
--             reporting
public fun createRegexp (r, name) {
  var l = [regexp (r), name];
  l
}

-- A matcher is a flat, immutable record [buf, pos, line, col].
--
-- It used to be a tuple of seven closures (show/eof/matchString/... each
-- capturing the whole enclosing frame). Because a matcher is part of every
-- parse result (Succ (value, stream)) and those results are retained in the
-- memo table, the heavy closure-tuple representation dominated the live heap.
-- A four-slot record is ~20x smaller and makes getPos/getLine/getCol plain
-- array reads instead of closure calls. The public interface below is
-- unchanged, so callers are unaffected.

-- Moves the position pointer forward `n` characters, recomputing line/col.
fun shiftMatcher (m, n) {
  var buf = m[0], pos = m[1], i, l = m[2], c = m[3];

  for i := pos, i < pos + n, i := i + 1 do
    case buf [i] of
        '\n' -> l := l + 1; c := 1
      | '\t' -> c := c + 8
      | _    -> c := c + 1
    esac
  od;

  [buf, pos + n, l, c]
}

-- Creates a fresh matcher from a string buffer.
public fun initMatcher (buf) {
  [buf, 0, 1, 1]
}

-- Gets a position
public fun getPos (m) {
  m [1]
}

-- Length of the underlying buffer (invariant for the whole parse).
public fun bufLength (m) {
  m [0].length
}

-- Gets a line number
public fun getLine (m) {
  m [2]
}

-- Gets a column number
public fun getCol (m) {
  m [3]
}

-- Shows a matcher in a readable form
public fun showMatcher (m) {
  sprintf ("buf : %-40s\npos : %d\nline: %d\ncol : %d\n", m[0], m[1], m[2], m[3])
}

-- Matches against a string
public fun matchString (m, s) {
  var buf = m[0], pos = m[1];

  if s.length > buf.length - pos
    then Fail (sprintf ("""%s"" expected", s), m[2], m[3])
    elif matchSubString (buf, s, pos) then Succ (s, shiftMatcher (m, s.length))
    else Fail (sprintf ("""%s"" expected at", s), m[2], m[3])
  fi
}

-- Matches against a regexp
public fun matchRegexp (m, r) {
  var buf = m[0], pos = m[1], n;

  if (n := regexpMatch (r[0], buf, pos)) >= 0
    then Succ (substring (buf, pos, n), shiftMatcher (m, n))
    else Fail (sprintf ("%s expected", r[1]), m[2], m[3])
  fi
}

-- Succeeds only at the end of input
public fun endOfMatcher (m) {
  if m[0].length - m[1] == 0
    then Succ ("", m)
    else Fail ("EOF expected", m[2], m[3])
  fi
}
