-- Lazy.
-- (C) Dmitry Boulytchev, JetBrains Research, St. Petersburg State University, 2020
--
-- Deferred computations.

import Ref;

public fun makeLazy (f) {
  -- state cell [set, value]: the closure below may not assign captured
  -- variables directly (unsupported by the selfhosted x86 compiler),
  -- so mutation goes through array elements instead
  var isSet = ref(false);
  var value = ref(0);

  fun () {
    if deref(isSet)
    then deref(value)
    else
      var c; -- need this temporary since in value := f () value would
               -- create an intermediate managed pointer
      c := f ();
      isSet ::= true;
      value ::= c;
      c
    fi
  } 
}

public fun force (f) {
  f ()
}