-- Timer.
-- (C) Dmitry Boulytchev, JetBrains Research, St. Petersburg State University, 2020
--
-- This unit provides an implementation for simple timer. A timer is a function which
-- measures an elapsed time (in microseconds) since its creation.

-- Creates a new timer
public fun timer () {
  var t = time ();

  fun () {
    time () - t
  }
}

-- Formats a given time (in microseconds) as a floating-point number of seconds.
public fun toSeconds (t) {
  var s = sprintf ("%d", t);

  while s.length < 7 do
    s := "0" + s
  od;

  sprintf ("%s.%s", substring (s, 0, s.length - 6), substring (s, s.length - 6, 6))
}